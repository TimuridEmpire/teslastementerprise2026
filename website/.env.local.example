# Copy this file to .env.local and fill in your values.

# URL of the running enterprise_router FastAPI server
NEXT_PUBLIC_API_URL=http://localhost:8000

# Admin secret — matches ROUTER_ADMIN_SECRET env var on the backend
NEXT_PUBLIC_ADMIN_SECRET=changeme

# MANAGER agent API key (issued via POST /agents/{agent_name}/issue-api-key)
NEXT_PUBLIC_MANAGER_API_KEY=
