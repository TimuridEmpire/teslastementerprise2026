# Non-secret template for website runtime environment variables.

# URL of the running enterprise_router FastAPI server
NEXT_PUBLIC_API_URL=http://localhost:8000

# Admin secret — matches ENTERPRISE_ROUTER_ADMIN_SECRET env var on the backend
NEXT_PUBLIC_ADMIN_SECRET=changeme

# MANAGER agent API key (issued via POST /agents/{agent_name}/issue-api-key)
NEXT_PUBLIC_MANAGER_API_KEY=

# Optional per-agent API keys for live queue panes on /agents/{agent}
NEXT_PUBLIC_CEO_API_KEY=
NEXT_PUBLIC_PM_API_KEY=
NEXT_PUBLIC_ENGINEERING_API_KEY=
NEXT_PUBLIC_HR_API_KEY=
NEXT_PUBLIC_SALES_API_KEY=
NEXT_PUBLIC_MARKETING_API_KEY=
NEXT_PUBLIC_FINANCE_API_KEY=
