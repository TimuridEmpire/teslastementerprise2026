# Template for website/.env.local.
#
# All server-side only — read by app/api/router/[...path]/route.ts, never
# by client code. Do NOT prefix any of these with NEXT_PUBLIC_: Next.js
# inlines NEXT_PUBLIC_* values into the client JS bundle at build time,
# which is exactly how this project used to ship its admin secret and
# every agent's API key to the browser in plaintext (see the Enterprise
# Deployment Blueprint's critical-path findings). The browser only ever
# talks to this site's own /api/router proxy — it never holds a real
# credential.

# URL of the running enterprise_router FastAPI server
ROUTER_URL=http://localhost:8000

# Admin secret — matches ENTERPRISE_ROUTER_ADMIN_SECRET on the backend
ENTERPRISE_ROUTER_ADMIN_SECRET=changeme

# MANAGER agent API key (issued via POST /agents/{agent_name}/issue-api-key)
MANAGER_AGENT_API_KEY=

# Per-agent API keys — needed for the per-department queue panes on
# /agents/{agent} and for Docker Compose's worker-* services (see
# docker-compose.yml and .env.example at the repo root).
CEO_AGENT_API_KEY=
PM_AGENT_API_KEY=
ENGINEERING_AGENT_API_KEY=
HR_AGENT_API_KEY=
SALES_AGENT_API_KEY=
MARKETING_AGENT_API_KEY=
FINANCE_AGENT_API_KEY=
