# Copy to .env and fill in real values. docker-compose.yml reads this file
# automatically. See the install steps at the top of docker-compose.yml.

# --- Router secrets -------------------------------------------------------
# Required. The router refuses to start on the placeholder defaults --
# see enterprise_router/config.py. Generate real random values, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ENTERPRISE_ROUTER_ADMIN_SECRET=
ENTERPRISE_ROUTER_SHARED_SECRET=

# --- LLM backend ------------------------------------------------------------
# Wherever your Ollama-compatible server actually runs. NOT localhost once
# any of this is containerized -- from inside a container, "localhost" is
# that container's own loopback, not the host or a sibling container.
#   - Ollama running on the host machine (Docker Desktop): http://host.docker.internal:11434
#   - Ollama as its own container on this compose network:  http://ollama:11434
#   - A shared Ollama/vLLM server elsewhere on the network:  http://<its-host>:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Full mode CrewAI code-generation model for Engineering. Must already be
# pulled on whatever OLLAMA_BASE_URL points at (`ollama pull <model>`) --
# there is no default installed by this project.
OLLAMA_MODEL=ollama/qwen2.5:7b

# --- Agent API keys ---------------------------------------------------------
# Leave blank until step 3 of the install flow (docker-compose.yml header):
# bring the router up first, run scripts/bootstrap_router_agents.py against
# it, then paste the keys it prints back in here. Each one is read by BOTH
# its worker-* service (remapped to ENTERPRISE_AGENT_API_KEY) AND the
# website's server-side proxy (app/api/router/[...path]/route.ts) -- never
# by the browser. Rotating a key means updating it here and restarting
# those two services, not touching anything client-side.
MANAGER_AGENT_API_KEY=
CEO_AGENT_API_KEY=
PM_AGENT_API_KEY=
ENGINEERING_AGENT_API_KEY=
HR_AGENT_API_KEY=
SALES_AGENT_API_KEY=
MARKETING_AGENT_API_KEY=
FINANCE_AGENT_API_KEY=
